{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/services/fabrication-facility",
      "destination": "/services/structural-steel-fabrication",
      "permanent": true
    },
    {
      "source": "/services/advanced-machinery",
      "destination": "/services/plate-bending-rolling",
      "permanent": true
    },
    {
      "source": "/services/cnc-laser-cutting",
      "destination": "/services/cnc-laser-plasma-cutting",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.jahsteel.ae"
        }
      ],
      "destination": "https://jahsteel.ae/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}